# =============================================================================
# BANKSUITE (Abia SME MFB Core Banking) — Environment Configuration (.env.example)
# =============================================================================
# BankSuite runs 100% standalone by default. Copteller cooperative management
# attaches optionally as a decoupled headless submodule over signed HTTP.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Primary BankSuite PostgreSQL Database
DATABASE_URI=postgresql://postgres.[project]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
PAYLOAD_SECRET=your-payload-secret
ADMIN_SECRET=your-admin-secret

# Automated Nightly Close-of-Business (EOD) Cron Secret (/api/cron/eod)
CRON_SECRET=your-cron-secret

# Optional: Modular Headless Copteller Submodule Integration
# Leave unset for pure standalone BankSuite deployment (zero cooperative dependencies).
# For independently deployed Copteller (zero shared DB), set COPTELLER_BRIDGE_URL + COPTELLER_BRIDGE_SECRET:
COPTELLER_BRIDGE_URL=https://your-copteller-instance.vercel.app
COPTELLER_BRIDGE_SECRET=shared-bridge-hmac-secret
# Optional: set to "http" to force signed HTTP bridge even if COPTELLER_DATABASE_URI is present
COPTELLER_BRIDGE_TRANSPORT=http
# Optional co-hosted fast-path (only when BankSuite & Copteller share a DB cluster):
# COPTELLER_DATABASE_URI=postgresql://...
